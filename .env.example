# Copy these variables into your hosting panel's Environment settings.
# Never commit a real .env file or paste secrets into GitHub.

# Discord Developer Portal > Applications > Your App > Bot > Reset Token
DISCORD_TOKEN=

# Discord Developer Portal > Applications > General Information > Application ID
CLIENT_ID=

# PostgreSQL connection URI from your database provider
# Example format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
